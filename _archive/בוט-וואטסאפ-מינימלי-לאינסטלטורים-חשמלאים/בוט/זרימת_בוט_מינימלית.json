{
  "name": "בוט מינימלי - אינסטלטור/חשמלאי",
  "description": "איסוף פרטים + מיון חירום + העברה לבעל העסק. ללא מתן מחיר.",
  "type": "wati_chatbot_flow",
  "language": "he",
  "nodes": [
    {
      "id": "start",
      "type": "message",
      "title": "ברכה",
      "text": "היי! איך אפשר לעזור?\n\nבחר אחת מהאפשרויות:",
      "buttons": [
        { "id": "emergency", "text": "חירום / דחוף" },
        { "id": "regular", "text": "פנייה רגילה" }
      ]
    },
    {
      "id": "emergency_check",
      "type": "message",
      "title": "מיון חירום",
      "text": "מה הבעיה בדיוק?\nבחר או תאר בקצרה:",
      "buttons": [
        { "id": "leak", "text": "נזילה / דליפה" },
        { "id": "burst", "text": "פיצוץ צינור" },
        { "id": "no_water", "text": "אין מים" },
        { "id": "elec_emerg", "text": "בעיה חשמלית דחופה" },
        { "id": "no_power", "text": "אין חשמל" },
        { "id": "emerg_other", "text": "אחר - דחוף" }
      ]
    },
    {
      "id": "emergency_handoff",
      "type": "handoff",
      "title": "העברה מיידית לחירום",
      "text": "קיבלתי את הפרטים. מעביר אותך מיד לבעל העסק.\n\nבינתיים אם אפשר, שלח כתובת + תמונה של הבעיה.",
      "assign_to_owner": true,
      "notify_owner": true,
      "notify_message": "חירום! פנייה דחופה מ-{{contact.name}} {{contact.phone}}. בעיה: {{last_answer}}"
    },
    {
      "id": "regular_name",
      "type": "question",
      "title": "שם",
      "question": "איך קוראים לך?",
      "field": "name",
      "input_type": "text"
    },
    {
      "id": "regular_address",
      "type": "question",
      "title": "כתובת",
      "question": "מה הכתובת? (עיר + רחוב + מספר בית)",
      "field": "address",
      "input_type": "text"
    },
    {
      "id": "regular_issue",
      "type": "question",
      "title": "תיאור הבעיה",
      "question": "תאר בקצרה את הבעיה",
      "field": "issue",
      "input_type": "text"
    },
    {
      "id": "regular_photo",
      "type": "question",
      "title": "תמונה",
      "question": "אם יש תמונה של הבעיה - שלח אותה כאן. אם אין, פשוט הקש 'אין'.",
      "field": "photo",
      "input_type": "media"
    },
    {
      "id": "regular_summary",
      "type": "message",
      "title": "סיכום והעברה",
      "text": "קיבלתי את הפרטים:\nשם: {{name}}\nכתובת: {{address}}\nבעיה: {{issue}}\n\nנשלח טכנאי לבדוק וייתן הצעה.\nאני מעביר אותך כעת לבעל העסק.",
      "buttons": [
        { "id": "handoff_regular", "text": "העבר לנציג" }
      ]
    },
    {
      "id": "handoff_regular_action",
      "type": "handoff",
      "title": "העברה לבעל העסק",
      "assign_to_owner": true,
      "notify_owner": true,
      "notify_message": "פנייה רגילה מ-{{name}} | טלפון: {{contact.phone}} | כתובת: {{address}} | בעיה: {{issue}}"
    }
  ],
  "rules": {
    "always_allow_human_handoff": true,
    "never_give_price": true,
    "emergency_keywords": ["נזילה", "דליפה", "פיצוץ", "מים גועשים", "אין מים", "חשמל", "קצר חשמלי", "אין חשמל"]
  }
}
